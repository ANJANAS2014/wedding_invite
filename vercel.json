{
  "regions": ["bom1"],
  "functions": {
    "api/share.js": { "includeFiles": "dist/index.html" }
  },
  "rewrites": [
    { "source": "/i", "destination": "/api/share" },
    { "source": "/i/:token", "destination": "/api/share?i=:token" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
